# WhatsApp (filled by HookMyApp)
#   Sandbox:     hookmyapp sandbox env --write .env
#   Real number: hookmyapp channels env <channel> --write .env
# The sandbox writes WHATSAPP_API_URL, a real channel writes META_GRAPH_API_URL. Either works.
WHATSAPP_API_URL=
META_GRAPH_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_HMAC_SECRET=
VERIFY_TOKEN=
PORT=3000

# Claude (https://platform.claude.com, API keys)
ANTHROPIC_API_KEY=

# Optional
# BOT_MODEL=claude-opus-5-5
# BOT_EFFORT=low            # low | medium | high. Customer chat rarely needs more than low.
# BUSINESS_FILE=business.md
# OWNER_PHONE=0501234567       # gets a WhatsApp when a customer needs a human (only if this phone
#                              # messaged the business number in the last 24 hours)
# HANDOFF_PAUSE_HOURS=12       # how long the bot stays quiet after a handoff
# HISTORY_TURNS=20             # how many back-and-forths the bot remembers per customer
# MAX_REPLIES_PER_HOUR=30      # per customer, protects your Anthropic bill from loops
# TYPING_INDICATOR=true        # read/typing has a short timeout; false skips it entirely
# WEBHOOK_PATH=/webhook/whatsapp
# FALLBACK_REPLY=...            # what the customer gets if Claude cannot answer
